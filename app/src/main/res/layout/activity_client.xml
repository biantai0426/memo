<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#121212"
    android:padding="16dp">

    <!-- IPアドレス表示と設定ボタン -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="12dp">

        <TextView
            android:id="@+id/tvTargetIp"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:text="接続先: スキャン中..."
            android:textColor="#00FF00"
            android:textSize="16sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btnConfigIp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="IP手動設定"
            android:backgroundTint="#444444"
            android:textColor="#FFFFFF" />
    </LinearLayout>

    <Switch
        android:id="@+id/previewToggleSwitch"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="現場のライブ映像を受信・表示"
        android:textColor="#FFFFFF"
        android:textSize="18sp"
        android:layout_marginBottom="16dp" />

    <WebView
        android:id="@+id/webView"
        android:layout_width="match_parent"
        android:layout_height="250dp"
        android:background="#000000"
        android:visibility="gone"
        android:layout_marginBottom="24dp" />

    <Button
        android:id="@+id/switchCameraButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="カメラ向き 切替 (内/外)"
        android:layout_marginBottom="12dp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginBottom="12dp">
        
        <Button
            android:id="@+id/startRecordButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="証拠保存 開始"
            android:layout_marginEnd="4dp"/>

        <Button
            android:id="@+id/stopRecordButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="証拠保存 停止"
            android:layout_marginStart="4dp"/>
    </LinearLayout>

    <Button
        android:id="@+id/sendNotificationButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="画面点灯用 カモフラージュ通知送信"
        android:layout_marginBottom="24dp" />

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#333333"
        android:layout_marginBottom="24dp"/>

    <Button
        android:id="@+id/downloadVideoButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="遠隔から証拠動画をダウンロード"
        android:backgroundTint="#0066CC"
        android:textColor="#FFFFFF" />

</LinearLayout>
