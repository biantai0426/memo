<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0F0F0F">

    <!-- メイン画面（YouTube Music偽装） -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <!-- トップバー（ヘッダー） -->
        <ImageView
            android:id="@+id/btnDown"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/ic_expand_more"
            android:padding="16dp"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent" />

        <!-- 上部中央のトグル（ダミー） -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:background="@drawable/bg_chip_dark"
            android:paddingHorizontal="12dp"
            android:paddingVertical="4dp"
            android:gravity="center_vertical"
            app:layout_constraintTop_toTopOf="@id/btnDown"
            app:layout_constraintBottom_toBottomOf="@id/btnDown"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">
            <!-- ヘッドホンアイコンは標準の物がないので文字で妥協、または別のダミーを使用 -->
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="🎧" android:textColor="#FFFFFF" android:paddingEnd="12dp"/>
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="▶" android:textColor="#888888" android:textSize="12sp"/>
        </LinearLayout>

        <ImageView
            android:id="@+id/btnConfigIpCamo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/ic_more_vert"
            android:padding="16dp"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <TextView
            android:id="@+id/tvTargetIpCamo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="📶"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:padding="16dp"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintEnd_toStartOf="@id/btnConfigIpCamo" />

        <!-- ジャケット画像（角丸） ＆ プレビュー領域 -->
        <androidx.cardview.widget.CardView
            android:id="@+id/jacketCard"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_marginHorizontal="24dp"
            android:layout_marginTop="16dp"
            app:cardCornerRadius="12dp"
            app:cardElevation="0dp"
            app:cardBackgroundColor="#222222"
            app:layout_constraintDimensionRatio="1:1"
            app:layout_constraintTop_toBottomOf="@id/btnDown"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <FrameLayout
                android:id="@+id/jacketContainer"
                android:layout_width="match_parent"
                android:layout_height="match_parent">
                
                <ImageView
                    android:id="@+id/imgJacket"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:scaleType="centerCrop" />

                <WebView
                    android:id="@+id/webViewCamo"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="#000000"
                    android:visibility="gone" />
            </FrameLayout>
        </androidx.cardview.widget.CardView>

        <!-- 曲名・アーティスト名 -->
        <TextView
            android:id="@+id/tvTrackTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="32dp"
            android:layout_marginHorizontal="24dp"
            android:text="なんもねえ ＞"
            android:textColor="#FFFFFF"
            android:textSize="24sp"
            android:textStyle="bold"
            app:layout_constraintTop_toBottomOf="@id/jacketCard"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <TextView
            android:id="@+id/tvTrackArtist"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="24dp"
            android:layout_marginTop="4dp"
            android:text="忘れらんねえよ"
            android:textColor="#AAAAAA"
            android:textSize="14sp"
            app:layout_constraintTop_toBottomOf="@id/tvTrackTitle"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <!-- アクションチップ（高評価、低評価など） -->
        <HorizontalScrollView
            android:id="@+id/actionScroll"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:scrollbars="none"
            app:layout_constraintTop_toBottomOf="@id/tvTrackArtist">
            
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:paddingHorizontal="24dp">
                
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_chip_dark"
                    android:text="👍 6.6万   👎"
                    android:textColor="#FFFFFF"
                    android:paddingHorizontal="16dp"
                    android:paddingVertical="8dp"
                    android:layout_marginEnd="8dp"/>
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_chip_dark"
                    android:text="💬 歌詞"
                    android:textColor="#FFFFFF"
                    android:paddingHorizontal="16dp"
                    android:paddingVertical="8dp"
                    android:layout_marginEnd="8dp"/>
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_chip_dark"
                    android:text="≡ 保存"
                    android:textColor="#FFFFFF"
                    android:paddingHorizontal="16dp"
                    android:paddingVertical="8dp"/>
            </LinearLayout>
        </HorizontalScrollView>

        <!-- シークバー（プログレス）と時間 -->
        <SeekBar
            android:id="@+id/progressBarCamo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="16dp"
            android:layout_marginTop="24dp"
            android:progress="0"
            android:progressTint="#FFFFFF"
            android:thumbTint="#FFFFFF"
            app:layout_constraintTop_toBottomOf="@id/actionScroll"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="24dp"
            android:text="0:00"
            android:textColor="#888888"
            android:textSize="12sp"
            app:layout_constraintTop_toBottomOf="@id/progressBarCamo"
            app:layout_constraintStart_toStartOf="parent"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="24dp"
            android:text="3:45"
            android:textColor="#888888"
            android:textSize="12sp"
            app:layout_constraintTop_toBottomOf="@id/progressBarCamo"
            app:layout_constraintEnd_toEndOf="parent"/>

        <!-- 再生コントローラー（画像を適用） -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center"
            android:layout_marginTop="16dp"
            app:layout_constraintTop_toBottomOf="@id/progressBarCamo">

            <ImageView 
                android:layout_width="0dp" 
                android:layout_height="wrap_content" 
                android:src="@drawable/ic_shuffle" 
                android:layout_weight="1"/>

            <!-- 戻る ＝ カメラ切替 -->
            <ImageView
                android:id="@+id/btnPrevCamo"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:src="@drawable/ic_skip_previous"
                android:layout_weight="1"/>

            <!-- 再生/停止 ＝ 録画開始/停止（白丸背景） -->
            <FrameLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1">
                
                <ImageView
                    android:id="@+id/btnPlayPauseCamo"
                    android:layout_width="72dp"
                    android:layout_height="72dp"
                    android:background="@drawable/bg_circle_white"
                    android:src="@drawable/ic_play_arrow_black"
                    android:padding="16dp"
                    android:layout_gravity="center" />
            </FrameLayout>

            <!-- 次へ ＝ カモフラージュ通知送信 -->
            <ImageView
                android:id="@+id/btnNextCamo"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:src="@drawable/ic_skip_next"
                android:layout_weight="1"/>
                
            <ImageView 
                android:layout_width="0dp" 
                android:layout_height="wrap_content" 
                android:src="@drawable/ic_repeat" 
                android:layout_weight="1"/>
        </LinearLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- ボトムシート（上にスワイプで引き出す録画一覧） -->
    <LinearLayout
        android:id="@+id/bottomSheet"
        android:layout_width="match_parent"
        android:layout_height="500dp"
        android:background="@drawable/bg_bottom_sheet"
        android:orientation="vertical"
        android:paddingTop="8dp"
        app:layout_behavior="com.google.android.material.bottomsheet.BottomSheetBehavior"
        app:behavior_hideable="false"
        app:behavior_peekHeight="70dp">

        <View
            android:layout_width="40dp"
            android:layout_height="4dp"
            android:background="#444444"
            android:layout_gravity="center_horizontal"
            android:layout_marginBottom="8dp"/>

        <TextView
            android:id="@+id/tvMixListTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="「なんもねえ」を元にしたミックスリスト"
            android:textColor="#FFFFFF"
            android:textSize="14sp"
            android:gravity="center"
            android:paddingBottom="16dp" />
            
        <View android:layout_width="match_parent" android:layout_height="1dp" android:background="#333333"/>

        <ListView
            android:id="@+id/lvVaultCamo"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

    </LinearLayout>

</androidx.coordinatorlayout.widget.CoordinatorLayout>
