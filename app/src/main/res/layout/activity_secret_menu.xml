<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="24dp"
    android:background="#121212"
    android:gravity="center_horizontal">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="コントロールハブ"
        android:textColor="#FFFFFF"
        android:textSize="20sp"
        android:textStyle="bold"
        android:layout_marginBottom="16dp" />

    <!-- 追加：サーバー情報（IPアドレス）の表示エリア -->
    <TextView
        android:id="@+id/tvServerInfo"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="IPアドレス取得中..."
        android:textColor="#00FF00"
        android:textSize="14sp"
        android:textStyle="bold"
        android:gravity="center"
        android:background="#1A1A1A"
        android:padding="12dp"
        android:layout_marginBottom="32dp" />

    <!-- クライアントモードへの遷移ボタン -->
    <Button
        android:id="@+id/btnClientMode"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="ローカル操作・プレビューパネル"
        android:layout_marginBottom="16dp" />

    <!-- シークレット動画金庫への遷移ボタン -->
    <Button
        android:id="@+id/btnVideoVault"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="シークレット動画金庫（Vault）"
        android:layout_marginBottom="16dp" />

    <!-- 自爆（データ消去）ボタン -->
    <Button
        android:id="@+id/btnSelfDestruct"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="自爆（全データ消去）"
        android:textColor="#FF0000"
        android:layout_marginTop="32dp" />
</LinearLayout>
