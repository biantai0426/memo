<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#121212"
    android:padding="24dp"
    android:gravity="center">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="コントロールハブ"
        android:textColor="#FFFFFF"
        android:textSize="24sp"
        android:textStyle="bold"
        android:layout_marginBottom="32dp" />

    <Button
        android:id="@+id/btnServerMode"
        android:layout_width="match_parent"
        android:layout_height="80dp"
        android:text="サーバーモード 起動\n(現場設置用：カメラと通信待機)"
        android:layout_marginBottom="16dp" />

    <Button
        android:id="@+id/btnClientMode"
        android:layout_width="match_parent"
        android:layout_height="80dp"
        android:text="クライアントモード 開く\n(手元の操作・遠隔監視用)"
        android:layout_marginBottom="16dp" />

    <Button
        android:id="@+id/btnVault"
        android:layout_width="match_parent"
        android:layout_height="80dp"
        android:text="動画一覧 (シークレットVault)\n(暗号化された証拠の確認)" />

</LinearLayout>
